[Unit]
Description=Nifty OTM signal report (3:20 PM exit run, sends Telegram)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=otm
WorkingDirectory=/opt/otm/app
EnvironmentFile=/etc/otm/otm.env
ExecStart=/opt/otm/venv/bin/otm report --notify --phase exit
TimeoutStartSec=300
