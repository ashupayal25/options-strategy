# Copy to .env for local runs (python-dotenv is not required; export these in your shell or set them in the systemd unit).
# Never commit the real values. On AWS the Telegram values come from SSM Parameter Store (see deploy/README.md).

# --- Telegram (create a bot with @BotFather, then message it once and read your chat id) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Where state lives ---
# empty            -> local files in the project folder (positions.json, reports/)
# a folder path    -> local files in that folder
# s3://bucket/otm/ -> S3 (uses the instance role on AWS)
OTM_STORE=

# If set, secrets are read from SSM Parameter Store under this prefix when the env vars above are empty.
# Parameters: <prefix>/telegram/bot_token and <prefix>/telegram/chat_id
OTM_SSM_PREFIX=

# --- Strategy settings (defaults are the locked rules) ---
OTM_LOTS=2
OTM_LOT_SIZE=65
OTM_PUT_OTM=2.0
OTM_CALL_OTM=3.0
OTM_HEDGE_EXTRA=2.0
OTM_RSI_SKIP=70
OTM_CONFIRM=2
OTM_SELL_SIDEWAYS=0
# Weekly expiry weekday: Monday=0 ... Tuesday=1 (verify on NSE)
OTM_EXPIRY_WEEKDAY=1
# Send a short daily summary at the 3:20 PM run
OTM_NOTIFY_DAILY_SUMMARY=1
